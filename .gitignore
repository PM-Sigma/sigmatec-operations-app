# internal notes / reference — NOT for the public repo (contain test creds + internal ids)
docs/claude-memory/
*.env
.env
node_modules/

# service-account / secret key files — NEVER commit
INFORMATION ACCOUNT JSON KEY.txt
*service-account*.json
*-sa-key*.json
*.key.json
desktop.ini
.claude/
.mcp.json
supabase/.temp/

# React islands workspace — source is committed, node_modules and the intermediate
# Vite output are not (ui/sigma.js|css IS committed: GitHub Pages serves it directly).
app/node_modules
app/dist

# ── QA gates (qa/, scripts/qa.mjs) ────────────────────────────────────────────────────────
# Configs, specs, the runners and ONE baseline report are committed; everything a run
# PRODUCES is not. Each tool re-creates its cache on first use (see qa/README.md).
# NOTE: .gitignore has no trailing comments — a "pattern  # why" line is one long pattern.
#
# the gitleaks binary (downloaded per machine)
qa/bin/
# screenshots — one set per project per run
qa/playwright/shots/
# semgrep rule packs, lighthouse runs, zap + gitleaks output
qa/**/.cache/
# Playwright's own failure artifacts (traces)
test-results/
playwright-report/
# every report a run writes…
qa/reports/*
# …except the baseline a reviewer needs
!qa/reports/2026-09-18-task-22.md
