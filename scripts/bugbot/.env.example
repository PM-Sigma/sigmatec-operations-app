# Copy to scripts/bugbot/.env (git-ignored) on the HOME SERVER and fill in yourself.
# Never commit it, never paste it in chat.
BUGBOT_SB_URL=https://<project-ref>.supabase.co
BUGBOT_SB_SERVICE_KEY=
# the same value as the CRON_SECRET secret of the Supabase edge functions
BUGBOT_CRON_SECRET=
# optional
# BUGBOT_REPO=C:\bugbot\sigmatec-operations-app
# BUGBOT_WORK_ROOT=C:\bugbot\work
# BUGBOT_STATE_DIR=C:\bugbot\state
# BUGBOT_CLAUDE=C:\Users\<user>\.local\bin\claude.exe
